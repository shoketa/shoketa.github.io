---
import '@fontsource-variable/geist-mono/wght.css';
import '@fontsource/noto-sans-tagalog/400.css';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { profile } from '../data/about';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Technical artist portfolio: shaders, rendering, tools and pipeline.' } = Astro.props;

const chapters = [
	{ label: 'about', href: '/#about', id: 'about' },
	{ label: 'projects', href: '/#projects', id: 'projects' },
	{ label: 'breakdowns', href: '/breakdowns/', id: 'breakdowns' },
];
const onBreakdowns = Astro.url.pathname.startsWith('/breakdowns');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/icon-transparent.png" />
		<link rel="icon" href="/icon-transparent.png" />
		<title>{title}</title>
		<!-- Apply a saved theme before first paint so there's no flash of the wrong one. -->
		<script is:inline>
			try {
				const theme = localStorage.getItem('theme');
				if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
			} catch {}
		</script>
	</head>
	<body>
		<header class="topbar">
			<div class="wrap bar">
				<a class="mark" href="/" aria-label="AV, home">
					<span class="baybayin-swap">
						<span class="latin">AV</span>
						<span class="baybayin" lang="tl" aria-hidden="true">{profile.initialsBaybayin}</span>
					</span>
				</a>
				<nav aria-label="Chapters">
					<ul>
						{
							chapters.map((c) => (
								<li>
									<a
										href={c.href}
										data-chapter={c.id}
										aria-current={c.id === 'breakdowns' && onBreakdowns ? 'page' : undefined}
									>
										<span aria-hidden="true">::</span> {c.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
				<ThemeToggle />
			</div>
		</header>
		<slot name="before-main" />
		<main class="wrap">
			<slot />
		</main>

		<!-- Decode text left to right on hover: links, and .baybayin-swap both ways. Skipped for reduced motion. -->
		<script>
			const DURATION_MS = 500;
			const FRAME_MS = 45;
			const BAYBAYIN = [...'ᜀᜁᜂᜃᜄᜅᜆᜇᜈᜉᜊᜋᜌᜎᜏᜐᜑ'];
			const BLOCKS = ['░', '▒', '▓'];

			// One entry per visible character, so vowel marks stay on their consonant.
			const split = (text: string) => text.match(/\P{M}\p{M}*/gu) ?? [];
			const pick = (pool: string[]) => pool[Math.floor(Math.random() * pool.length)];

			// Runs until the text is resolved. Returns a function that cancels it.
			const decode = (write: (text: string) => void, text: string, pool: string[]) => {
				const chars = split(text);
				const start = performance.now();
				let timer = 0;
				const tick = () => {
					const resolved = Math.floor(((performance.now() - start) / DURATION_MS) * chars.length);
					write(chars.map((c, i) => (i < resolved || !c.trim() ? c : pick(pool))).join(''));
					if (resolved < chars.length) timer = window.setTimeout(tick, FRAME_MS);
				};
				tick();
				return () => clearTimeout(timer);
			};

			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
				// The media link is hidden from assistive tech and holds no text; decorative :: marks stay put.
				for (const link of document.querySelectorAll('nav a, main a:not(.media)')) {
					const walker = document.createTreeWalker(link, NodeFilter.SHOW_TEXT);
					const nodes: Text[] = [];
					while (walker.nextNode()) {
						const node = walker.currentNode as Text;
						if (node.data.trim() && !node.parentElement?.closest('[aria-hidden]')) nodes.push(node);
					}
					const texts = nodes.map((node) => node.data);
					let stops: (() => void)[] = [];

					// Project rows hover as a whole, so the title decodes from anywhere in the row.
					(link.closest('.row') ?? link).addEventListener('mouseenter', () => {
						stops.forEach((stop) => stop());
						stops = nodes.map((node, i) => decode((text) => (node.data = text), texts[i], BLOCKS));
					});
				}

				for (const swap of document.querySelectorAll('.baybayin-swap')) {
					const latin = swap.querySelector<HTMLElement>('.latin');
					const baybayin = swap.querySelector<HTMLElement>('.baybayin');
					if (!latin || !baybayin) continue;

					const latinText = latin.textContent ?? '';
					const baybayinText = baybayin.textContent ?? '';
					let stop = () => {};

					const run = (el: HTMLElement, text: string, pool: string[]) => {
						stop();
						latin.textContent = latinText;
						baybayin.textContent = baybayinText;
						stop = decode((scrambled) => (el.textContent = scrambled), text, pool);
					};

					swap.addEventListener('mouseenter', () => run(baybayin, baybayinText, BAYBAYIN));
					swap.addEventListener('mouseleave', () => run(latin, latinText, BLOCKS));
				}
			}
		</script>

		<!-- Play clips marked data-autoplay only while on screen. Reduced motion gets controls instead. -->
		<script>
			const clips = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');
			if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
				clips.forEach((v) => (v.controls = true));
			} else {
				const observer = new IntersectionObserver(
					(entries) => {
						for (const { target, isIntersecting } of entries) {
							const v = target as HTMLVideoElement;
							isIntersecting ? v.play().catch(() => {}) : v.pause();
						}
					},
					{ threshold: 0.25 }
				);
				clips.forEach((v) => observer.observe(v));
			}
		</script>

		<!-- Smooth scrolling, including chapter links. Skipped for reduced motion. -->
		<script>
			import Lenis from 'lenis';
			import 'lenis/dist/lenis.css';

			// Anchors clear the sticky header via scroll-padding, which both Lenis and native jumps
			// respect. Measured, because the header wraps to two rows on phones.
			const header = document.querySelector<HTMLElement>('.topbar');
			if (header) {
				const syncPadding = () =>
					document.documentElement.style.setProperty('scroll-padding-top', `${header.offsetHeight}px`);
				syncPadding();
				new ResizeObserver(syncPadding).observe(header);
			}

			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
				const lenis = new Lenis({ autoRaf: true });

				document.querySelectorAll<HTMLAnchorElement>('a[href*="#"]').forEach((link) => {
					link.addEventListener('click', (event) => {
						const url = new URL(link.href);
						if (url.pathname !== location.pathname) return;
						const target = document.getElementById(decodeURIComponent(url.hash.slice(1)));
						if (!target) return;
						event.preventDefault();
						lenis.scrollTo(target);
						history.pushState(null, '', url.hash);
					});
				});
			}
		</script>

		<!-- Mark the chapter currently in view. Only runs where chapter sections exist. -->
		<script is:inline>
			(() => {
				const sections = document.querySelectorAll('main section[id]');
				if (!sections.length || !('IntersectionObserver' in window)) return;
				const links = document.querySelectorAll('nav a[data-chapter]');
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;
							links.forEach((a) =>
								a.dataset.chapter === entry.target.id
									? a.setAttribute('aria-current', 'location')
									: a.removeAttribute('aria-current')
							);
						}
					},
					{ rootMargin: '-40% 0px -55% 0px' }
				);
				sections.forEach((s) => observer.observe(s));
			})();
		</script>
	</body>
</html>

<style>
	.topbar {
		position: sticky;
		top: 0;
		z-index: 10;
		background: var(--bg);
		/* border-bottom: 1px solid var(--border); */
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		height: 3.5rem;
	}

	.mark {
		font-weight: 700;
		font-size: 1.125rem;
		letter-spacing: 0.02em;
		color: var(--fg);
		text-decoration: none;
	}

	nav {
		margin-left: auto;
	}

	ul {
		display: flex;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	nav a {
		color: var(--muted);
		text-decoration: none;
		white-space: nowrap;
	}

	nav a:hover {
		color: var(--fg);
	}

	nav a[aria-current] {
		color: var(--fg);
		box-shadow: inset 0 -2px var(--accent);
	}

	nav a span {
		color: var(--accent-text);
	}

	/* Phones: nav drops to its own row under AV and the toggle. */
	@media (max-width: 36rem) {
		.bar {
			flex-wrap: wrap;
			justify-content: space-between;
			height: auto;
			row-gap: 0.25rem;
			padding-top: 0.5rem;
			padding-bottom: 0.5rem;
		}

		nav {
			order: 3;
			width: 100%;
			margin-left: 0;
		}

		ul {
			justify-content: space-between;
		}
	}
</style>

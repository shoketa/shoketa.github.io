---
// Running line of tools. Two copies scroll as one loop; screen readers get the list once.
interface Props {
	items: string[];
}

const { items } = Astro.props;
---

<div class="marquee" role="img" aria-label={`Tools: ${items.join(', ')}`}>
	{
		[0, 1].map(() => (
			<p aria-hidden="true">
				{items.map((item) => (
					<>
						<span class="sep">░</span>
						<span>{item}</span>
					</>
				))}
				<span class="sep">░</span>
			</p>
		))
	}
</div>

<style>
	.marquee {
		display: flex;
		overflow: hidden;
		color: var(--muted);
		font-size: 0.8125rem;
		mask-image: linear-gradient(90deg, transparent, #000 4rem, #000 calc(100% - 4rem), transparent);
	}

	p {
		display: flex;
		flex-shrink: 0;
		gap: 2rem;
		margin: 0;
		padding: 0.75rem 1rem;
		white-space: nowrap;
		animation: run 40s linear infinite;
	}

	.sep {
		color: var(--accent-text);
	}

	@keyframes run {
		to {
			transform: translateX(-100%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		p {
			animation: none;
		}
	}
</style>

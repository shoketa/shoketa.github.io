---
// Interactive 3D character. It sits above the fold, so everything loads straight away:
// the mesh and texture are preloaded in parallel with the three.js chunk.
import meshUrl from '../assets/meshes/SM_Allen_WelcomePose.glb?url';
import diffuseUrl from '../assets/textures/chibi_diffuse.png?url';
import portrait from '../assets/images/portrait.png';
---

<link rel="preload" href={meshUrl} as="fetch" crossorigin="anonymous" />
<link rel="preload" href={diffuseUrl} as="image" crossorigin="anonymous" />

<figure class="scene" id="character-scene" aria-label="3D character, drag to rotate">
	<span class="hint" aria-hidden="true">rotate me!</span>
	<!-- Shown if the 3D scene can't start, or swapped in by double-clicking (easter egg). -->
	<img class="fallback" src={portrait.src} width={portrait.width} height={portrait.height} alt="Portrait of Allen" />
</figure>

<script>
	const container = document.getElementById('character-scene');
	const img = container?.querySelector<HTMLImageElement>('.fallback');

	// Recolour the black/white portrait to the theme: black → --bg, white → --fg.
	if (img) {
		const source = new Image();
		source.src = img.src;
		const toRgb = (ctx: CanvasRenderingContext2D, color: string) => {
			ctx.clearRect(0, 0, 1, 1);
			ctx.fillStyle = color;
			ctx.fillRect(0, 0, 1, 1);
			return ctx.getImageData(0, 0, 1, 1).data;
		};
		const paint = () => {
			if (!source.complete || !source.naturalWidth) return;
			const { naturalWidth: w, naturalHeight: h } = source;
			const canvas = document.createElement('canvas');
			canvas.width = w;
			canvas.height = h;
			const ctx = canvas.getContext('2d', { willReadFrequently: true });
			if (!ctx) return;
			const style = getComputedStyle(document.documentElement);
			const fg = toRgb(ctx, style.getPropertyValue('--fg'));
			const bg = toRgb(ctx, style.getPropertyValue('--bg'));
			ctx.drawImage(source, 0, 0);
			const pixels = ctx.getImageData(0, 0, w, h);
			const d = pixels.data;
			for (let i = 0; i < d.length; i += 4) {
				const l = (d[i] + d[i + 1] + d[i + 2]) / 765;
				d[i] = bg[0] + (fg[0] - bg[0]) * l;
				d[i + 1] = bg[1] + (fg[1] - bg[1]) * l;
				d[i + 2] = bg[2] + (fg[2] - bg[2]) * l;
			}
			ctx.putImageData(pixels, 0, 0);
			img.src = canvas.toDataURL();
		};
		source.addEventListener('load', paint);
		paint();
		// Repaint on theme toggle and on OS scheme changes.
		new MutationObserver(paint).observe(document.documentElement, { attributeFilter: ['data-theme'] });
		matchMedia('(prefers-color-scheme: dark)').addEventListener('change', paint);
	}

	if (container) {
		const showFallback = () => container.classList.add('failed');
		container.addEventListener('dblclick', () => container.classList.toggle('portrait'));
		import('../scripts/sidebar-scene')
			.then(({ createScene }) => createScene(container))
			.then((ok) => ok || showFallback())
			.catch((e) => {
				console.warn('[sidebar-scene] init failed:', e);
				showFallback();
			});
	}
</script>

<style>
	.scene {
		position: relative;
		width: min(16rem, 60vw);
		aspect-ratio: 1;
		margin: 0;
		/* Canvas and portrait share one cell so they occupy the same space. */
		display: grid;
		/* Double-clicking toggles the portrait; don't select nearby text. */
		user-select: none;
	}

	.scene > :global(*) {
		grid-area: 1 / 1;
	}

	.scene :global(canvas) {
		display: block;
		width: 100%;
		height: 100%;
		cursor: grab;
		/* Vertical swipes still scroll the page on touch screens; horizontal ones rotate. */
		touch-action: pan-y;
		/* Low-res render scaled up: keep pixels hard-edged. */
		image-rendering: pixelated;
		opacity: 0;
		transition: opacity 0.4s ease-out;
	}

	.scene:global(.loaded) :global(canvas) {
		opacity: 1;
	}

	.scene :global(canvas:active) {
		cursor: grabbing;
	}

	.hint {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0.5rem;
		text-align: center;
		font-size: 0.8125rem;
		color: var(--muted);
		pointer-events: none;
		user-select: none;
		opacity: 0;
		transition: opacity 0.4s;
	}

	.scene:global(.loaded) .hint {
		opacity: 1;
	}

	.scene:global(.dragged) .hint {
		opacity: 0;
	}

	.fallback {
		display: none;
		width: 100%;
		height: 100%;
		image-rendering: pixelated;
	}

	.scene:global(.failed) .fallback,
	.scene:global(.portrait) .fallback {
		display: block;
	}

	/* three.js sets an inline display on its canvas, so hide it with visibility instead. */
	.scene:global(.portrait) :global(canvas),
	.scene:global(.portrait) .hint {
		visibility: hidden;
	}
</style>
